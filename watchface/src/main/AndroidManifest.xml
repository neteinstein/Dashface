<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!--
        Data sources used by watchface.xml that need a runtime permission.
        Heart rate ([HEART_RATE]):
          - Wear OS 5 and older: BODY_SENSORS (capped at API 35).
          - Wear OS 6+ (API 36): android.permission.health.READ_HEART_RATE.
        Steps ([STEP_COUNT], [STEP_PERCENT]): ACTIVITY_RECOGNITION.
        The WFF runtime asks the user for these when the face is selected; if they are
        denied the arcs show their empty track and a dash placeholder, never stale values.
        Nothing else is requested: no network, no location, no background access.
    -->
    <uses-permission
        android:name="android.permission.BODY_SENSORS"
        android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Watch Face Format packages must not contain code. -->
    <application
        android:hasCode="false"
        android:label="@string/watch_face_name">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Weather + Flavors require WFF version 2 (Wear OS 5+). -->
        <property
            android:name="com.google.wear.watchface.format.version"
            android:value="2" />
    </application>
</manifest>
